# Plantilla — copiar a `.env` (ese SÍ está en .gitignore) y rellenar.
# NUNCA subas el .env real a git ni lo pongas en OneDrive/skills.

# Token que devuelve @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu chat_id personal (ver paso 2 del README: getUpdates).
TELEGRAM_CHAT_ID=987654321

# Politica de la ruta PR del /merge. Opcional; sin declarar vale `ventana`.
#   ventana  un PR que abre el puente NO se integra en la misma pulsacion:
#            lo publica, te manda el link y pide un segundo /merge
#   off      el puente nunca integra por PR (lo abre y ahi lo deja)
#   auto     el comportamiento viejo: abrir e integrar de una. Se avisa al
#            arrancar y en cada merge, porque se salta la revision
# Cualquier otro valor se trata como `off`, nombrandolo: una variable mal
# escrita no puede conceder mas permiso que una bien escrita.
#CLAUDE_TG_PR_MERGE=ventana
