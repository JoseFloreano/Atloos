# ══════════════════════════════════════════════════════════════════════════
#  claude-telegram-doctor.{service,timer} — el latido diario del `doctor`.
#
#  ✅ PROBADO EN CAMPO: floreano-server, 2026-08-18, POR LOS DOS LADOS — y salio
#     mejor de lo previsto. No hizo falta el flag `--siempre`: la MISMA orden, en
#     la MISMA maquina, con lo unico distinto siendo la divergencia:
#
#       con divergencia (faltaba el CLAUDE.md) -> "Enviado: mensaje + adjunto
#                                                  doctor-floreano-server-...txt"
#       sin divergencia (CLAUDE.md generado)   -> "sin divergencias, no se avisa"
#                                                  exit 0, y NADA al movil
#
#     Eso es una mutacion de dos lados hecha en campo: no prueba que el script
#     sepa decir las dos frases, prueba que la frase DEPENDE del estado. El timer
#     quedo instalado, primer disparo 2026-08-19 00:01:51 CST.
#
#  Cubre lo que el `OnFailure` NO ve, que es casi todo lo que mata despacio a una
#  maquina headless: el disco llenandose, el journal sin techo, un `CLAUDE.md`
#  que se quedo atras, y la exencion del suelo que caduca sin que nadie mire.
#
#  **Calla cuando todo esta bien**, y eso es el diseno: un aviso diario que
#  siempre dice «todo bien» se deja de leer en una semana. La logica vive en
#  `latido-doctor.sh`, que cuelga el envio del exit code del doctor.
#
#  INSTALACION — copia CADA bloque a su fichero, sustituyendo <REPO>:
#      ~/.config/systemd/user/claude-telegram-doctor.service
#      ~/.config/systemd/user/claude-telegram-doctor.timer
#  y luego:
#      systemctl --user daemon-reload
#      systemctl --user enable --now claude-telegram-doctor.timer
#      systemctl --user list-timers claude-telegram-doctor
#
#  Para verlo YA, sin esperar al dia siguiente:
#      setup/telegram-bridge/latido-doctor.sh --siempre   # fuerza el envio
#      systemctl --user start claude-telegram-doctor.service
#      journalctl --user -u claude-telegram-doctor -n 30 --no-pager
# ══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── claude-telegram-doctor.service ───────────────
[Unit]
Description=Latido diario del doctor (avisa SOLO si hay divergencia)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=<REPO>
ExecStart=<REPO>/setup/telegram-bridge/latido-doctor.sh
StandardOutput=journal
StandardError=journal

# ─────────────────────────── claude-telegram-doctor.timer ─────────────────
# [Unit]
# Description=Corre el doctor una vez al dia
#
# [Timer]
# OnCalendar=daily
# # Sin esto, una maquina apagada a la hora del timer se salta el dia entero, y
# # el latido se pierde justo cuando mas informacion daria.
# Persistent=true
# # Diez minutos de dispersion: no hace falta la hora en punto.
# RandomizedDelaySec=600
#
# [Install]
# WantedBy=timers.target
