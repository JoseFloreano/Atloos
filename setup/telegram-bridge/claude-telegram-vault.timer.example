# ══════════════════════════════════════════════════════════════════════════
#  claude-telegram-vault.{service,timer} — la sincronia del vault en la maquina
#  que no tiene Obsidian.
#
#  ✅ ESTADO: **PROBADO 2026-08-20 en floreano-server**, por los dos lados.
#    A · `is-enabled` -> enabled; NEXT 08:18:52, Result=success tras un disparo real
#    B · el timer disparo solo a las 07:57:35: Finished en 2 s y CERO lineas al journal
#    C · conflicto fabricado -> exit 1, 🔴 al movil (187 chars), NO quedo en rebase
#
#  ⚠ Dos avisos para quien lo instale, medidos ese dia:
#    · el fichero esta en git como `100644`: invocarlo directo da `Permission
#      denied` (exit 126). Por eso la unit lo llama con `/bin/bash`, y por eso
#      cualquier receta que diga `vault-sync.sh ...` a secas falla aqui.
#    · con `RandomizedDelaySec=120`, LEFT nunca baja de 20min: el valor sano es
#      20-22min, no "<20min". Un criterio que pida menos se contradice con esta unit.
#
#  POR QUE. El vault es un repo git que en las laptops sincroniza el plugin Git de
#  Obsidian. La SER8 no tiene Obsidian, asi que sin esto el vault de la maquina
#  24/7 solo se movia cuando alguien entraba por ssh a hacer `git pull`. La
#  logica —y sobre todo la regla de NO resolver conflictos— vive en
#  `vault-sync.sh`, que **calla cuando todo esta bien**.
#
#  CADENCIA: cada 20 min. No es un numero magico: es el orden de magnitud del
#  autocommit del plugin en las laptops, asi que las dos puntas del vault se
#  mueven al mismo ritmo. Subirlo mucho devuelve el problema (trabajas contra un
#  briefing viejo); bajarlo mucho solo gasta red.
#
#  INSTALACION — copia CADA bloque a su fichero, sustituyendo <REPO>:
#      ~/.config/systemd/user/claude-telegram-vault.service
#      ~/.config/systemd/user/claude-telegram-vault.timer
#  y luego:
#      systemctl --user daemon-reload
#      systemctl --user enable --now claude-telegram-vault.timer
#      systemctl --user list-timers claude-telegram-vault
#
#  Y para que siga corriendo con la sesion cerrada (una caja headless casi nunca
#  tiene sesion abierta), lo mismo que el daemon:
#      sudo loginctl enable-linger "$USER"
#
#  COMO EJERCERLO POR LOS DOS LADOS (que es lo unico que lo dara por probado):
#      # a) el lado que calla: con el vault al dia
#      setup/telegram-bridge/vault-sync.sh --verboso     # debe decir "al dia" y NADA al movil
#      # b) el lado que habla: se fabrica un conflicto a proposito
#      #    edita la MISMA linea de un fichero en la laptop (y pushea) y en la
#      #    SER8 (sin pushear), y corre el script: debe abortar el rebase,
#      #    dejar el vault como estaba y mandar el 🔴 al movil.
#      git -C ~/DevSetup/ObsidianVault status    # comprobar que NO quedo en rebase
# ══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── claude-telegram-vault.service ────────────────
[Unit]
Description=Sincroniza el vault de Obsidian (sustituye al plugin Git en la caja sin Obsidian)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=<REPO>
# Se invoca con /bin/bash a proposito: asi la unit no depende del bit de
# ejecucion del fichero, que es lo que se pierde al copiar el repo entre
# maquinas (y en Windows no existe).
ExecStart=/bin/bash <REPO>/setup/telegram-bridge/vault-sync.sh
StandardOutput=journal
StandardError=journal

# ─────────────────────────── claude-telegram-vault.timer ──────────────────
# [Unit]
# Description=Sincroniza el vault cada 20 minutos
#
# [Timer]
# OnBootSec=2min
# OnUnitActiveSec=20min
# # Una maquina apagada a la hora del disparo se saltaria la ventana entera; con
# # esto el primer arranque recupera la sincronia en vez de esperar 20 min.
# Persistent=true
# RandomizedDelaySec=120
#
# [Install]
# WantedBy=timers.target
